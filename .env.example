# RPC endpoint for Arbitrum
RPC_URL=https://arb1.arbitrum.io/rpc

# Your main wallet private key (0x prefix)
PRIVATE_KEY=0x...

# Agent wallet private key (0x prefix)
# Generate a fresh random wallet - this key can only trade, not withdraw
# Example: openssl rand -hex 32, then prefix with 0x
AGENT_PRIVATE_KEY=0x...

# Boros API base URL
# Production: https://api-boros.pendle.finance
API_BASE_URL=https://api-boros.pendle.finance
