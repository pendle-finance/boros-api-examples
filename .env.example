# RPC endpoint for Arbitrum
RPC_URL=https://arb1.arbitrum.io/rpc

# Your main wallet private key (0x prefix)
PRIVATE_KEY=0x...

# Agent wallet private key (0x prefix)
# Generate a fresh random wallet - this key can only trade, not withdraw
# Example: openssl rand -hex 32, then prefix with 0x
AGENT_PRIVATE_KEY=0x...

# --- Stop orders only (example 14) ---
# Ed25519 API signing key. Every other example runs without these.
#
# Mint one at https://api-boros.pendle.finance/dashboard, or with
# `yarn example:api-keys`: POST /v1/api-keys is authenticated by an EIP-712
# signature from the wallet in PRIVATE_KEY above, or from AGENT_PRIVATE_KEY once
# that agent is approved - so no browser and no root key are needed. The PEM is
# returned once and never again - if you lose it, revoke the key and mint another.
#
# Key id, shown when the key is created
BOROS_API_KEY_ID=pdk_...
# The PKCS#8 PEM, on one line with \n for the line breaks:
#   awk 'BEGIN{ORS="\\n"} {print}' key.pem
BOROS_API_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
